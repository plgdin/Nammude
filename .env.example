# Supabase Public Configuration (Browser Safe)
# Replace with your real Supabase Project credentials from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-here

# Base Domain for Multi-Tenant Subdomain Routing (e.g., localhost or platform.com)
VITE_TENANT_BASE_DOMAIN=localhost

# Development Mock Authentication Mode
# Set to 'true' only in local development when live Supabase credentials are not yet configured.
# NEVER enable this in staging or production.
VITE_ENABLE_DEV_MOCK_AUTH=true
